# Copy to .env and edit. Every variable is optional in dev; the ones marked PROD are required when HUAYU_ENV=prod.
#
# FORMAT RULES (so that the same lines work for Docker Compose, systemd and local dev):
#  - One NAME=value per line. Write comments on a line of their own, NEVER after a value: systemd keeps the text after the
#    value as part of the value, and an invite code or a boolean would break.
#  - A value with $ or # in it (a password, an invite code): put it in 'single quotes'. Docker Compose would otherwise
#    expand $... and cut at " #". A value with spaces or brackets: "double quotes" (or single quotes).
#  - Docker install: copy this file to .env next to compose.yml. compose.yml forces HUAYU_ENV, HUAYU_DATA_DIR,
#    HUAYU_TRUSTED_PROXY and HUAYU_BASE_URL, so a stray value here cannot turn production into dev mode.
#  - No-Docker install: /etc/huayu-coach.env is a SYSTEMD file, not this one (see deploy/deploy.md section 16).
#
# Docker Compose only: your domain, WITHOUT https:// and WITHOUT a slash or path (huayu.example.com).
# The public address https://<DOMAIN> is built from it, and password-reset links use that address.
# DOMAIN=huayu.example.com

HUAYU_ENV=dev
# PROD: at least 32 random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
HUAYU_SECRET_KEY=
HUAYU_BASE_URL=http://localhost:8000
# Closed beta: when set, registration requires this code.
HUAYU_INVITE_CODE=
# false closes sign-up completely.
# HUAYU_REGISTRATION_OPEN=true
# HUAYU_MIN_PASSWORD_LENGTH=8
# vi | zh-TW | en
# HUAYU_DEFAULT_LOCALE=vi
# HUAYU_TIMEZONE=Asia/Taipei

# Where the database (huayu.db) and the outbox live. Docker sets /data itself.
# HUAYU_DATA_DIR=./data
# Overrides the SQLite file in the data directory. Leave empty unless you know you need it.
# HUAYU_DATABASE_URL=
# true only behind a reverse proxy you control (Caddy): the real client IP is then read from X-Forwarded-For. Docker sets it.
# HUAYU_TRUSTED_PROXY=false
# Default: true in dev, false in prod (only teacher-approved questions are served). See deploy/deploy.md section 7.
# HUAYU_ALLOW_UNREVIEWED_QUESTIONS=

# Billing. false = everyone has free access (good for the pilot).
HUAYU_BILLING_ENABLED=false
HUAYU_TRIAL_DAYS=14
HUAYU_PAYMENT_INSTRUCTIONS=
HUAYU_SUPPORT_EMAIL=
# Who runs the service (shown on /privacy and /terms; empty = a visible yellow placeholder stays)
HUAYU_OPERATOR_NAME=
HUAYU_OPERATOR_ADDRESS=
HUAYU_OPERATOR_TAX_ID=

# AI explanations (optional; the app works fully without them, using template text)
# none | openai | anthropic
HUAYU_LLM_PROVIDER=none
HUAYU_LLM_MODEL=
HUAYU_LLM_API_KEY=
# Another OpenAI-compatible endpoint, if you use one.
# HUAYU_LLM_BASE_URL=
# Seconds to wait for the AI before falling back to template text.
# HUAYU_LLM_TIMEOUT_S=8.0

# Email. Without SMTP, emails (address + password-reset link) are written to data/outbox/ and NOT sent: configure SMTP in prod.
# Port and security must match: 587 + starttls (most providers), 465 + ssl (implicit TLS), none = plain text, only for a relay
# on the same machine or a private network. A wrong pair fails after 15 s and the error is in the app log.
HUAYU_SMTP_HOST=
HUAYU_SMTP_PORT=587
# starttls | ssl | none
HUAYU_SMTP_SECURITY=starttls
HUAYU_SMTP_USER=
HUAYU_SMTP_PASSWORD=
HUAYU_SMTP_FROM=
